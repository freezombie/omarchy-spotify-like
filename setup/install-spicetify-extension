#!/bin/bash
# Patch the Spotify desktop app with Spicetify and load only the
# spotify-like-bridge extension. Run as yourself (no sudo), after:
#   1. spicetify-cli is installed (AUR), and
#   2. setup/grant-spotify-write-access has given your user write access.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/spicetify

command -v spicetify >/dev/null || { echo "spicetify is not installed" >&2; exit 1; }
[[ -w /opt/spotify/Apps ]] || { echo "/opt/spotify/Apps is not writable: run setup/grant-spotify-write-access first" >&2; exit 1; }

# First run creates config-xpui.ini and finds /opt/spotify on its own.
spicetify path >/dev/null 2>&1 || true

mkdir -p "$config_dir/Extensions"
ln -sfn "$repo/spicetify/spotify-like-bridge.js" "$config_dir/Extensions/spotify-like-bridge.js"

# Audit conditions (vault note "2026-11-12 Spotify like button"):
# no update check that renders GitHub text in the app, no extra UI patches,
# and our extension as the only one.
spicetify config \
  check_spicetify_update 0 \
  experimental_features 0 \
  home_config 0 \
  sidebar_config 0 \
  inject_theme_js 0 \
  extensions spotify-like-bridge.js

# Apply with no network (unprivileged user+net namespace): spicetify would
# otherwise download css-map.json from GitHub (main branch) and string-replace
# it into Spotify's JavaScript, bypassing the AUR package's checksum pin. With
# the fetch failing it uses the css-map.json shipped in the package. Inside the
# namespace we look like root to spicetify, hence --bypass-admin; -n because a
# Spotify started in there would have no network either.
unshare --map-root-user --net spicetify --bypass-admin --no-restart backup apply
spicetify restart
echo "Done. Spotify restarts patched; the heart appears in the bar while a song plays."
